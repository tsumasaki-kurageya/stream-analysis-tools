# Local development only. Do not reuse these credentials outside a developer machine.
POSTGRES_USER=stream_analysis
POSTGRES_PASSWORD=stream_analysis_local
POSTGRES_DB=stream_analysis
POSTGRES_TEST_DB=stream_analysis_test
POSTGRES_PORT=5432

# Applied only when a new data volume is initialized.
POSTGRES_INITDB_ARGS="--data-checksums --encoding=UTF8"

# Main API. Keep the real YouTube API key only in an untracked .env file.
YSA_DATABASE_URL=postgresql://stream_analysis:stream_analysis_local@localhost:5432/stream_analysis?sslmode=disable
YSA_MIGRATIONS_DIR=migrations
YSA_YOUTUBE_API_KEY=
YSA_YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# Collection Worker temporary-artifact safety limits.
# Production deployments must leave queue consumption disabled until every canary gate passes.
YSA_WORKER_QUEUE_ENABLED=false
YSA_WORKER_ID=local-worker
YSA_WORKER_LEASE_SECONDS=120
YSA_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
YSA_WORKER_POLL_INTERVAL_SECONDS=1
YSA_WORKER_ATTEMPT_TIMEOUT_SECONDS=1800
YSA_WORKER_ATTEMPT_ROOT=/tmp/stream-analysis-worker
YSA_WORKER_ORPHAN_AFTER_SECONDS=86400
YSA_WORKER_MINIMUM_FREE_BYTES=1073741824
